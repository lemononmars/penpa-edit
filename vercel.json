{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/"
    }
  ]
}
