{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path((?!assets/|js/|css/|fonts/|.*\\.[a-zA-Z0-9]+$).*)",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/:path"
    }
  ]
}
