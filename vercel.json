{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/puzzle",
      "destination": "/index.html"
    },
    {
      "source": "/puzzle/",
      "destination": "/index.html"
    },
    {
      "source": "/wpc2026",
      "destination": "/wpc2026/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/index.html"
    },
    {
      "source": "/leaderboard",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/leaderboard/index.html"
    },
    {
      "source": "/tournament",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/tournament/index.html"
    },
    {
      "source": "/tournament/host",
      "has": [
        {
          "type": "host",
          "value": "(.*sudokubattle.*|.*sudoku-battle.*)"
        }
      ],
      "destination": "/battle/tournament/host/index.html"
    }
  ]
}
